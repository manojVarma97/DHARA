# Change all passwords/secrets before deployment.
POSTGRES_DB=dhara
POSTGRES_USER=dhara_user
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://dhara_user:CHANGE_ME_LONG_RANDOM_PASSWORD@db:5432/dhara

API_PORT=8000
FRONTEND_PORT=8080
NODE_RED_PORT=1880
NODE_RED_CREDENTIAL_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_SECRET

# Optional integrations - leave blank until configured.
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v22.0

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Outside-VZM delivery is deliberately not configured in the starter.
OUTSIDE_VZM_DELIVERY_FEE_PAISE=
